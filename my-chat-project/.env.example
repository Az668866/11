# 后端必填（所有真实值只放在部署平台的 Secret/Environment 中）
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# 首次升级必须先复制当前 TOKEN_SECRET 的真实值到这里；以后保持不变，
# 这样轮换 TOKEN_SECRET 只会撤销会话，不会破坏卡密、TOTP 或加密语音。
DATA_PROTECTION_SECRET=REPLACE_WITH_CURRENT_TOKEN_SECRET_BEFORE_ROTATION
PUBLIC_API_BASE=https://api.example.com
# 活码入口与 API 分离；请填已在 DNS/Render/Cloudflare 配好的长期域名。
# 不要使用会改名的 Render/Netlify 免费随机子域名。
QR_ENTRY_BASE=https://go.example.com
# 每个租户独占用户端入口。首次部署请先部署 Worker 和泛域名 DNS，
# 确认测试域名 HTTPS 正常后再设为 true。
TENANT_ENTRY_ENABLED=false
# 支持多个完全不同的主域名，逗号分隔；入口创建和轮换时会分散使用。
TENANT_ENTRY_DOMAIN_SUFFIXES=example.com
# 使用 Cloudflare Worker 版入口时，至少32位随机字符串，并与 Worker Secret 一致；
# 只使用 Netlify 独立站点时可以留空。
TENANT_ENTRY_GATEWAY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# 旧域名继续映射原租户的天数；0 表示不自动过期。
TENANT_ENTRY_LEGACY_DAYS=30
# 每个租户自动创建一个独立的 Netlify 用户端站点。启用后不需要
# Cloudflare Worker；站点默认使用 4 位短名称，例如 a8k2.netlify.app。
TENANT_NETLIFY_ENABLED=false
# Netlify 个人访问令牌，只放 Render Secret，不要提交到仓库。
NETLIFY_AUTH_TOKEN=
TENANT_NETLIFY_TEAM_SLUG=
TENANT_NETLIFY_NAME_LENGTH=4
TENANT_NETLIFY_BUNDLE_ROOT=tenant-site-bundles
# 这里只固定管理端；启用/测试中的用户模板域名会从超级后台模板表动态加载
ALLOWED_ORIGINS=https://tenant.example.com,https://distributor.example.com,https://super.example.com
APP_VERSION=2.4.8
LEGACY_API_ENABLED=false
STRICT_CLIENT_ORIGIN=true
# 正式用户端均需携带构建时注入的模板 UUID；仅临时兼容旧站时才设 false
REQUIRE_CLIENT_TEMPLATE_ID=true

# 超级管理员
SUPER_ADMIN_USERNAME=replace_admin_name
SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
SUPER_ADMIN_TOTP_SECRET=REPLACE_WITH_BASE32_SECRET
REQUIRE_SUPER_ADMIN_TOTP=true
# 留空使用仅 API 主机可接收的 Host-only Cookie
COOKIE_DOMAIN=
COOKIE_SECURE=true

# Cloudflare 源站保护：先配置 Worker/Transform Rule 与防火墙再开启
REQUIRE_CLOUDFLARE=false
CLOUDFLARE_ORIGIN_SECRET=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARACTERS
# Cloudflare Realtime TURN/SFU 用量（超级后台和 TG 状态指令，只读）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_API_TOKEN=
# Cloudflare Realtime 免费额度与付费额度合计；按账号实际套餐填写。
CLOUDFLARE_REALTIME_MONTHLY_QUOTA_GB=1000
CLOUDFLARE_ANALYTICS_CACHE_MINUTES=15

# Telegram
# 新数据库首次启动的默认平台客服；已有数据库请在超级后台“平台设置”中修改。
CUSTOMER_SERVICE_TELEGRAM=@your_customer_service
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_GROUP_IDS=

# 消息、分页、资源与异常阈值
CHAT_RETENTION_HOURS=24
TOKEN_TTL_HOURS=24
API_PAGE_DEFAULT=50
API_PAGE_MAX=100
MAX_CONVERSATIONS=1000
MAX_MESSAGES_PER_CONVERSATION=100
MAX_SSE_CONNECTIONS=500
DB_POOL_MAX=5
CONFIG_CACHE_SECONDS=300
AUDIT_RETENTION_DAYS=90
SLOW_API_MS=1000
SLOW_QUERY_MS=500
QR_INCIDENT_WINDOW_MINUTES=10
QR_INCIDENT_REVIEW_THRESHOLD=10
ANOMALY_VISITOR_IP_10M=12
ANOMALY_VISITOR_TENANT_10M=120
ANOMALY_MESSAGES_CONVERSATION_10M=80
ANOMALY_MESSAGES_TENANT_10M=600
# 未登录模板来源不一致会立即拒绝，连续达到该次数才告警；有效签名
# 令牌从其他来源跨站使用会多信号确认并立即告警，不使用这个阈值。
ANOMALY_ORIGIN_MISMATCH_10M=3
SECURITY_IP_BLOCK_HOURS=24
SECURITY_ALERT_COOLDOWN_MINUTES=10
# 普通卡密默认允许设备数；每张卡可在超级后台单独修改。
LICENSE_DESKTOP_DEVICE_DEFAULT=3
LICENSE_MOBILE_DEVICE_DEFAULT=3
# 卡密到期后的数据保留宽限期。默认 3 天，之后自动清除租户业务数据。
EXPIRED_TENANT_GRACE_DAYS=3
# 判断租户“正在双向聊天”的最近人工消息窗口。
ACTIVE_CHAT_WINDOW_MINUTES=10

# 媒体对象存储（生产建议配置，避免大文件占数据库）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# WebRTC 通话：Cloudflare Realtime TURN（推荐，只能放后端 Render）
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
# 1 小时至 48 小时；默认 24 小时。后端按用户缓存，临近过期才刷新。
CLOUDFLARE_TURN_TTL_SECONDS=86400

# 自建或第三方静态 TURN 备用；会与 Cloudflare TURN 合并下发，适合大陆链路容灾。
# 建议同时填写 UDP、TCP 与 TLS 443 三种地址，例如：
# turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
WEBRTC_STUN_URLS=stun:stun.cloudflare.com:3478

# 呼叫响铃与异常会话兜底超时；通常保持默认值即可。
CALL_RING_TIMEOUT_SECONDS=45
CALL_ACTIVE_TIMEOUT_SECONDS=43200
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# PWA 后台来电推送（使用 npx web-push generate-vapid-keys 生成，私钥只放 Render）
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:security@example.com
# 可选：仅当浏览器使用非 Chrome/Firefox/Safari/Edge 官方推送域名时追加。
WEB_PUSH_ALLOWED_HOSTS=

# 前端构建变量（非机密）
VITE_API_BASE=https://api.example.com
VITE_CLIENT_TEMPLATE_ID=11111111-1111-4111-8111-111111111111
VITE_CLIENT_VERSION=2.4.8
VITE_OBFUSCATE=true
