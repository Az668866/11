name = "tuojie-tenant-entry"
main = "worker.js"
compatibility_date = "2026-08-21"

[vars]
BACKEND_API_BASE = "https://api.ykf000.com"
RESERVED_HOSTS = "api.ykf000.com,go.ykf000.com,www.ykf000.com,ykf000.com"
RESOLVE_CACHE_SECONDS = "30"

# TENANT_ENTRY_GATEWAY_SECRET 必须使用 Secret 配置：
# npx wrangler secret put TENANT_ENTRY_GATEWAY_SECRET
#
# 推荐在 Cloudflare 控制台添加路由，不要把真实 Zone ID 写入源码：
# *.ykf000.com/*
